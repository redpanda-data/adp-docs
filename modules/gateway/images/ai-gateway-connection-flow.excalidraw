    {
      "id": "title",
      "type": "text",
      "x": 58,
      "y": 46,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "AI Gateway separates client access from provider secrets",
      "fontSize": 34,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:37:02.028Z",
      "updatedAt": "2026-08-06T21:37:02.028Z",
      "version": 1
    },
    {
      "id": "subtitle",
      "type": "text",
      "x": 60,
      "y": 98,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Configure the upstream once; every local or deployed client uses the governed proxy path",
      "fontSize": 20,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:37:02.028Z",
      "updatedAt": "2026-08-06T21:37:02.028Z",
      "version": 1
