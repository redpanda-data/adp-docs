    {
      "id": "title",
      "type": "text",
      "x": 58,
      "y": 46,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "MCP Gateway gives every server one governed tool path",
      "fontSize": 34,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:29.069Z",
      "updatedAt": "2026-08-06T17:26:29.069Z",
      "version": 1
    },
    {
      "id": "subtitle",
      "type": "text",
      "x": 60,
      "y": 98,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Agents and external clients use the same discovery and call pattern across managed and self-managed backends",
      "fontSize": 20,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:29.069Z",
      "updatedAt": "2026-08-06T17:26:29.069Z",
      "version": 1
    },
    {
      "id": "callers-title",
      "type": "text",
      "x": 79,
      "y": 274,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "MCP callers",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:29.069Z",
      "updatedAt": "2026-08-06T17:26:29.069Z",
      "version": 1
    },
    {
      "id": "callers-body",
      "type": "text",
      "x": 79,
      "y": 316,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Managed agents\nSelf-managed agents\nExternal MCP clients",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:29.069Z",
      "updatedAt": "2026-08-06T17:26:29.069Z",
      "version": 1
    },
    {
      "id": "gateway-title",
      "type": "text",
      "x": 414,
      "y": 224,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "MCP Gateway",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:29.069Z",
      "updatedAt": "2026-08-06T17:26:29.069Z",
      "version": 1
    },
    {
      "id": "gateway-body",
      "type": "text",
      "x": 414,
      "y": 266,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Authenticate identity\nAuthorize tool access\nResolve upstream auth\nApply data policies\nRecord calls and errors",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:29.069Z",
      "updatedAt": "2026-08-06T17:26:29.069Z",
      "version": 1
    },
    {
      "id": "managed-title",
      "type": "text",
      "x": 809,
      "y": 179,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "Managed server",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:29.069Z",
      "updatedAt": "2026-08-06T17:26:29.069Z",
      "version": 1
    },
    {
      "id": "managed-body",
      "type": "text",
      "x": 809,
      "y": 221,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Redpanda runs the\nMCP implementation",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:29.069Z",
      "updatedAt": "2026-08-06T17:26:29.069Z",
      "version": 1
    },
    {
      "id": "self-title",
      "type": "text",
      "x": 809,
      "y": 479,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "Self-managed server",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:29.069Z",
      "updatedAt": "2026-08-06T17:26:29.069Z",
      "version": 1
    },
    {
      "id": "self-body",
      "type": "text",
      "x": 809,
      "y": 521,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "You run the endpoint;\nRedpanda fronts it",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:29.069Z",
      "updatedAt": "2026-08-06T17:26:29.069Z",
      "version": 1
    },
    {
      "id": "systems-title",
      "type": "text",
      "x": 1164,
      "y": 259,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "Upstream\nsystems",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:29.069Z",
      "updatedAt": "2026-08-06T17:26:29.069Z",
      "version": 1
    },
    {
      "id": "systems-body",
      "type": "text",
      "x": 1164,
      "y": 331,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Databases\nAPIs\nBusiness apps",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:29.069Z",
      "updatedAt": "2026-08-06T17:26:29.069Z",
      "version": 1
    },
    {
      "id": "protocol-text",
      "type": "text",
      "x": 368,
      "y": 693,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "MCP discovery and JSON-RPC stay consistent across both paths",
      "fontSize": 20,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:29.069Z",
      "updatedAt": "2026-08-06T17:26:29.069Z",
