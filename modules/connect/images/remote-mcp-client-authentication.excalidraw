    {
      "id": "title",
      "type": "text",
      "x": 58,
      "y": 46,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "One tool call can cross two OAuth boundaries",
      "fontSize": 34,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:24:28.491Z",
      "updatedAt": "2026-08-06T17:24:28.491Z",
      "version": 1
    },
    {
      "id": "subtitle",
      "type": "text",
      "x": 60,
      "y": 98,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Inbound client identity and outbound upstream identity solve different authentication problems",
      "fontSize": 20,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:24:28.492Z",
      "updatedAt": "2026-08-06T17:24:28.492Z",
      "version": 1
    },
    {
      "id": "client-title",
      "type": "text",
      "x": 74,
      "y": 259,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "External MCP\nclient",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:24:28.492Z",
      "updatedAt": "2026-08-06T17:24:28.492Z",
      "version": 1
    },
    {
      "id": "client-body",
      "type": "text",
      "x": 74,
      "y": 331,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Claude, ChatGPT,\nGemini, Cursor,\nor another client",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:24:28.492Z",
      "updatedAt": "2026-08-06T17:24:28.492Z",
      "version": 1
    },
    {
      "id": "inbound-title",
      "type": "text",
      "x": 349,
      "y": 229,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "Inbound OAuth\nclient",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:24:28.492Z",
      "updatedAt": "2026-08-06T17:24:28.492Z",
      "version": 1
    },
    {
      "id": "inbound-body",
      "type": "text",
      "x": 349,
      "y": 301,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Identifies app\nChecks redirect URI\nAuthorizes access\nto AI Gateway",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:24:28.492Z",
      "updatedAt": "2026-08-06T17:24:28.492Z",
      "version": 1
    },
    {
      "id": "gateway-title",
      "type": "text",
      "x": 639,
      "y": 229,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "AI Gateway\nand MCP",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:24:28.492Z",
      "updatedAt": "2026-08-06T17:24:28.492Z",
      "version": 1
    },
    {
      "id": "gateway-body",
      "type": "text",
      "x": 639,
      "y": 301,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Authenticates user\nInvokes the tool\nApplies access policy\nRecords the call",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:24:28.492Z",
      "updatedAt": "2026-08-06T17:24:28.492Z",
      "version": 1
    },
    {
      "id": "outbound-title",
      "type": "text",
      "x": 922,
      "y": 229,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "Outbound OAuth\nprovider",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:24:28.492Z",
      "updatedAt": "2026-08-06T17:24:28.492Z",
      "version": 1
    },
    {
      "id": "outbound-body",
      "type": "text",
      "x": 922,
      "y": 301,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Acts for user at\nupstream system\nwhen delegated\nOAuth is configured",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:24:28.492Z",
      "updatedAt": "2026-08-06T17:24:28.492Z",
      "version": 1
    },
    {
      "id": "upstream-title",
      "type": "text",
      "x": 1224,
      "y": 274,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "Upstream",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:24:28.492Z",
      "updatedAt": "2026-08-06T17:24:28.492Z",
      "version": 1
    },
    {
      "id": "upstream-body",
      "type": "text",
      "x": 1224,
      "y": 316,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "GitHub\nSlack\nSalesforce",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:24:28.492Z",
      "updatedAt": "2026-08-06T17:24:28.492Z",
      "version": 1
    },
    {
