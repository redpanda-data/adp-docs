    {
      "id": "title",
      "type": "text",
      "x": 58,
      "y": 46,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "Coding agents use the gateway, not provider keys",
      "fontSize": 34,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:37:16.492Z",
      "updatedAt": "2026-08-06T21:37:16.492Z",
      "version": 1
    },
    {
      "id": "subtitle",
      "type": "text",
      "x": 60,
      "y": 98,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "One local sign-in routes model traffic and records usage without writing an upstream key to disk",
      "fontSize": 20,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:37:16.492Z",
      "updatedAt": "2026-08-06T21:37:16.492Z",
      "version": 1
    },
    {
      "id": "workstation-title",
      "type": "text",
      "x": 82,
      "y": 274,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "Developer machine",
      "fontSize": 24,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:37:16.492Z",
      "updatedAt": "2026-08-06T21:37:16.492Z",
      "version": 1
    },
    {
      "id": "workstation-body",
      "type": "text",
      "x": 82,
      "y": 316,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Claude Code or Codex\n\nNo provider key\nstored here",
      "fontSize": 21,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:37:16.492Z",
      "updatedAt": "2026-08-06T21:37:16.492Z",
      "version": 1
    },
    {
      "id": "rpk-title",
      "type": "text",
      "x": 406,
      "y": 274,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "Run coding agent",
      "fontSize": 24,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:37:16.492Z",
      "updatedAt": "2026-08-06T21:37:16.492Z",
      "version": 1
    },
    {
      "id": "rpk-body",
      "type": "text",
      "x": 406,
      "y": 316,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "rpk ai run\n\nUses selected context",
      "fontSize": 21,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:37:16.492Z",
      "updatedAt": "2026-08-06T21:37:16.492Z",
      "version": 1
    },
    {
      "id": "gateway-title",
      "type": "text",
      "x": 710,
      "y": 244,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "AI Gateway",
      "fontSize": 24,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:37:16.492Z",
      "updatedAt": "2026-08-06T21:37:16.492Z",
      "version": 1
    },
    {
      "id": "gateway-body",
      "type": "text",
      "x": 710,
      "y": 286,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Authenticates caller\nRoutes native API\nApplies policy\nRecords usage",
      "fontSize": 21,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:37:16.492Z",
      "updatedAt": "2026-08-06T21:37:16.492Z",
      "version": 1
    },
    {
      "id": "provider-title",
      "type": "text",
      "x": 1054,
      "y": 274,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "LLM provider",
      "fontSize": 24,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:37:16.492Z",
      "updatedAt": "2026-08-06T21:37:16.492Z",
      "version": 1
    },
    {
      "id": "provider-body",
      "type": "text",
      "x": 1054,
      "y": 316,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Managed access,\nAWS Bedrock, or\nenterprise passthrough",
      "fontSize": 21,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:37:16.492Z",
      "updatedAt": "2026-08-06T21:37:16.492Z",
