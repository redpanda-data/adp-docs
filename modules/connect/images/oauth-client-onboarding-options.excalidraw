    {
      "id": "title",
      "type": "text",
      "x": 58,
      "y": 46,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "Three ways an external MCP client can identify itself",
      "fontSize": 34,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:53.608Z",
      "updatedAt": "2026-08-06T17:26:53.608Z",
      "version": 1
    },
    {
      "id": "subtitle",
      "type": "text",
      "x": 60,
      "y": 98,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Choose the lightest onboarding method the client supports; all paths end at the same authorization flow",
      "fontSize": 20,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:53.608Z",
      "updatedAt": "2026-08-06T17:26:53.608Z",
      "version": 1
    },
    {
      "id": "client-title",
      "type": "text",
      "x": 54,
      "y": 294,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "External MCP client",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:53.608Z",
      "updatedAt": "2026-08-06T17:26:53.608Z",
      "version": 1
    },
    {
      "id": "client-body",
      "type": "text",
      "x": 54,
      "y": 336,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Needs permission to\nreach an MCP server\nthrough AI Gateway",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:53.608Z",
      "updatedAt": "2026-08-06T17:26:53.608Z",
      "version": 1
    },
    {
      "id": "cimd-title",
      "type": "text",
      "x": 409,
      "y": 179,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "Metadata document",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:53.608Z",
      "updatedAt": "2026-08-06T17:26:53.608Z",
      "version": 1
    },
    {
      "id": "cimd-body",
      "type": "text",
      "x": 409,
      "y": 221,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "HTTPS URL as client ID\nGateway reads\nredirect URIs\nNo stored registration",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:53.608Z",
      "updatedAt": "2026-08-06T17:26:53.608Z",
      "version": 1
    },
    {
      "id": "dcr-title",
      "type": "text",
      "x": 409,
      "y": 414,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "Dynamic registration",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:53.608Z",
      "updatedAt": "2026-08-06T17:26:53.608Z",
      "version": 1
    },
    {
      "id": "dcr-body",
      "type": "text",
      "x": 409,
      "y": 456,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Client creates and\nupdates its own\nsaved registration",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:53.608Z",
      "updatedAt": "2026-08-06T17:26:53.608Z",
      "version": 1
    },
    {
      "id": "manual-title",
      "type": "text",
      "x": 409,
      "y": 649,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "Manual registration",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:53.608Z",
      "updatedAt": "2026-08-06T17:26:53.608Z",
      "version": 1
    },
    {
      "id": "manual-body",
      "type": "text",
      "x": 409,
      "y": 691,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Administrator creates it\nand shares credentials",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:53.608Z",
      "updatedAt": "2026-08-06T17:26:53.608Z",
      "version": 1
    },
    {
      "id": "authorize-title",
      "type": "text",
      "x": 800,
      "y": 294,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "OAuth authorization",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:53.608Z",
      "updatedAt": "2026-08-06T17:26:53.608Z",
      "version": 1
    },
    {
      "id": "authorize-body",
      "type": "text",
      "x": 800,
      "y": 336,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Validate client\nand redirect URI\nUser grants access\nIssue short-lived\ntokens",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:53.608Z",
      "updatedAt": "2026-08-06T17:26:53.608Z",
      "version": 1
    },
    {
      "id": "gateway-title",
      "type": "text",
      "x": 1184,
      "y": 309,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "AI Gateway",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:53.608Z",
      "updatedAt": "2026-08-06T17:26:53.608Z",
      "version": 1
    },
    {
      "id": "gateway-body",
      "type": "text",
      "x": 1184,
      "y": 351,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Client can call\nallowed MCP\ntools",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:53.608Z",
      "updatedAt": "2026-08-06T17:26:53.608Z",
