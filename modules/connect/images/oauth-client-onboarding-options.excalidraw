    {
      "id": "title",
      "type": "text",
      "x": 58,
      "y": 46,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "Three ways an external MCP client can identify itself",
      "fontSize": 34,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:55:52.736Z",
      "updatedAt": "2026-08-06T21:55:52.736Z",
      "version": 1
    },
    {
      "id": "subtitle",
      "type": "text",
      "x": 60,
      "y": 98,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Choose the lightest onboarding method the client supports; all paths end at the same authorization flow",
      "fontSize": 20,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:55:52.736Z",
      "updatedAt": "2026-08-06T21:55:52.736Z",
      "version": 1
    },
    {
      "id": "client-title",
      "type": "text",
      "x": 54,
      "y": 309,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "External MCP\nclient",
      "fontSize": 24,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:55:52.736Z",
      "updatedAt": "2026-08-06T21:55:52.736Z",
      "version": 1
    },
    {
      "id": "client-body",
      "type": "text",
      "x": 54,
      "y": 381,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Needs access to an\nMCP server through\nAI Gateway",
      "fontSize": 21,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:55:52.736Z",
      "updatedAt": "2026-08-06T21:55:52.736Z",
      "version": 1
    },
    {
      "id": "cimd-title",
      "type": "text",
      "x": 369,
      "y": 164,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "Client ID metadata",
      "fontSize": 24,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:55:52.736Z",
      "updatedAt": "2026-08-06T21:55:52.736Z",
      "version": 1
    },
    {
      "id": "cimd-body",
      "type": "text",
      "x": 369,
      "y": 206,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "HTTPS URL as client ID\nGateway reads\nredirect URIs\nNo stored registration",
      "fontSize": 21,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:55:52.736Z",
      "updatedAt": "2026-08-06T21:55:52.736Z",
      "version": 1
    },
    {
      "id": "dcr-title",
      "type": "text",
      "x": 369,
      "y": 394,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "Dynamic registration",
      "fontSize": 24,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:55:52.736Z",
      "updatedAt": "2026-08-06T21:55:52.736Z",
      "version": 1
    },
    {
      "id": "dcr-body",
      "type": "text",
      "x": 369,
      "y": 436,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Client creates and updates\nits saved registration",
      "fontSize": 21,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:55:52.736Z",
      "updatedAt": "2026-08-06T21:55:52.736Z",
      "version": 1
    },
    {
      "id": "manual-title",
      "type": "text",
      "x": 369,
      "y": 599,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "Manual registration",
      "fontSize": 24,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:55:52.736Z",
      "updatedAt": "2026-08-06T21:55:52.736Z",
      "version": 1
    },
    {
      "id": "manual-body",
      "type": "text",
      "x": 369,
      "y": 641,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Admin registers\nredirect URIs\nDistributes credentials",
      "fontSize": 21,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:55:52.736Z",
      "updatedAt": "2026-08-06T21:55:52.736Z",
      "version": 1
    },
    {
      "id": "authorize-title",
      "type": "text",
      "x": 784,
      "y": 309,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "OAuth authorization",
      "fontSize": 24,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:55:52.736Z",
      "updatedAt": "2026-08-06T21:55:52.736Z",
      "version": 1
    },
    {
      "id": "authorize-body",
      "type": "text",
      "x": 784,
      "y": 351,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Validate identity\nConfirm redirect URI\nUser grants access\nIssue short-lived\ntokens",
      "fontSize": 21,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:55:52.736Z",
      "updatedAt": "2026-08-06T21:55:52.736Z",
      "version": 1
    },
    {
      "id": "gateway-title",
      "type": "text",
      "x": 1154,
      "y": 329,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "AI Gateway",
      "fontSize": 24,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:55:52.736Z",
      "updatedAt": "2026-08-06T21:55:52.736Z",
      "version": 1
    },
    {
      "id": "gateway-body",
      "type": "text",
      "x": 1154,
      "y": 371,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Client can call\npermitted MCP\ntools",
      "fontSize": 21,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:55:52.736Z",
      "updatedAt": "2026-08-06T21:55:52.736Z",
