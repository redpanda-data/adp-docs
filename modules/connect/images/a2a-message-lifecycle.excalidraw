    {
      "id": "title",
      "type": "text",
      "x": 58,
      "y": 46,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "A2A lets callers discover and invoke an agent",
      "fontSize": 34,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:25:37.857Z",
      "updatedAt": "2026-08-06T17:25:37.857Z",
      "version": 1
    },
    {
      "id": "subtitle",
      "type": "text",
      "x": 60,
      "y": 98,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "The caller learns the interface first, then authenticates and exchanges messages or task updates",
      "fontSize": 20,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:25:37.857Z",
      "updatedAt": "2026-08-06T17:25:37.857Z",
      "version": 1
    },
    {
      "id": "caller-title",
      "type": "text",
      "x": 64,
      "y": 269,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "Caller",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:25:37.857Z",
      "updatedAt": "2026-08-06T17:25:37.857Z",
      "version": 1
    },
    {
      "id": "caller-body",
      "type": "text",
      "x": 64,
      "y": 311,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Application\nExternal agent\nRedpanda\npipeline",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:25:37.857Z",
      "updatedAt": "2026-08-06T17:25:37.857Z",
      "version": 1
    },
    {
      "id": "card-title",
      "type": "text",
      "x": 324,
      "y": 239,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "1. Discover",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:25:37.857Z",
      "updatedAt": "2026-08-06T17:25:37.857Z",
      "version": 1
    },
    {
      "id": "card-body",
      "type": "text",
      "x": 324,
      "y": 281,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Fetch the public\nagent card\n\nRead capabilities,\ninterfaces, and\nprotocol version",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:25:37.857Z",
      "updatedAt": "2026-08-06T17:25:37.857Z",
      "version": 1
    },
    {
      "id": "auth-title",
      "type": "text",
      "x": 599,
      "y": 269,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "2. Sign in",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:25:37.857Z",
      "updatedAt": "2026-08-06T17:25:37.857Z",
      "version": 1
    },
    {
      "id": "auth-body",
      "type": "text",
      "x": 599,
      "y": 311,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Get a short-lived\naccess token",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:25:37.857Z",
      "updatedAt": "2026-08-06T17:25:37.857Z",
      "version": 1
    },
    {
      "id": "message-title",
      "type": "text",
      "x": 859,
      "y": 239,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "3. Send message",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:25:37.857Z",
      "updatedAt": "2026-08-06T17:25:37.857Z",
      "version": 1
    },
    {
      "id": "message-body",
      "type": "text",
      "x": 859,
      "y": 281,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Use supported\ninterface and\nprotocol version\n\nAgent stays opaque",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:25:37.857Z",
      "updatedAt": "2026-08-06T17:25:37.857Z",
      "version": 1
    },
    {
      "id": "outcome-title",
      "type": "text",
      "x": 1134,
      "y": 239,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "4. Receive",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:25:37.857Z",
      "updatedAt": "2026-08-06T17:25:37.857Z",
      "version": 1
    },
    {
      "id": "outcome-body",
      "type": "text",
      "x": 1134,
      "y": 281,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Direct response\nor streamed task\nstatus and\nartifacts",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:25:37.857Z",
      "updatedAt": "2026-08-06T17:25:37.857Z",
      "version": 1
    },
    {
      "id": "modern-text",
      "type": "text",
      "x": 333,
      "y": 603,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "Current A2A: explicit interfaces, version negotiation, consistent outcomes",
      "fontSize": 20,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:25:37.857Z",
      "updatedAt": "2026-08-06T17:25:37.857Z",
      "version": 1
    }
