    {
      "id": "title",
      "type": "text",
      "x": 58,
      "y": 46,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "rpk ai is the terminal entry point to Agentic Data Plane",
      "fontSize": 34,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:43:30.117Z",
      "updatedAt": "2026-08-06T21:43:30.117Z",
      "version": 1
    },
    {
      "id": "subtitle",
      "type": "text",
      "x": 60,
      "y": 98,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Install the plugin once, select an environment, then use the same authenticated context for every workflow",
      "fontSize": 20,
      "fontFamily": 2,
      "createdAt": "2026-08-06T21:43:30.117Z",
      "updatedAt": "2026-08-06T21:43:30.117Z",
      "version": 1
    },
    {
