    {
      "id": "title",
      "type": "text",
      "x": 58,
      "y": 46,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "`rpk ai` is the terminal entry point to Agentic Data Plane",
      "fontSize": 34,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:17.654Z",
      "updatedAt": "2026-08-06T17:26:17.654Z",
      "version": 1
    },
    {
      "id": "subtitle",
      "type": "text",
      "x": 60,
      "y": 98,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Install the plugin once, select an environment, then use the same authenticated gateway for every workflow",
      "fontSize": 20,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:17.654Z",
      "updatedAt": "2026-08-06T17:26:17.654Z",
      "version": 1
    },
    {
      "id": "install-title",
      "type": "text",
      "x": 79,
      "y": 259,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "Install plugin",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:17.654Z",
      "updatedAt": "2026-08-06T17:26:17.654Z",
      "version": 1
    },
    {
      "id": "install-body",
      "type": "text",
      "x": 79,
      "y": 301,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "`rpk ai install`\n\nRuns through your\nexisting `rpk` setup",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:17.654Z",
      "updatedAt": "2026-08-06T17:26:17.654Z",
      "version": 1
    },
    {
      "id": "login-title",
      "type": "text",
      "x": 374,
      "y": 229,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "Sign in and select",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:17.654Z",
      "updatedAt": "2026-08-06T17:26:17.654Z",
      "version": 1
    },
    {
      "id": "login-body",
      "type": "text",
      "x": 374,
      "y": 271,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "`rpk ai auth login`\n`rpk ai env use`\n\nOne active Agentic\nData Plane\nenvironment",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:17.654Z",
      "updatedAt": "2026-08-06T17:26:17.654Z",
      "version": 1
    },
    {
      "id": "manage-title",
      "type": "text",
      "x": 744,
      "y": 174,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "Manage resources",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:17.654Z",
      "updatedAt": "2026-08-06T17:26:17.654Z",
      "version": 1
    },
    {
      "id": "manage-body",
      "type": "text",
      "x": 744,
      "y": 216,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Providers\nMCP servers\nOAuth and agents",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:17.654Z",
      "updatedAt": "2026-08-06T17:26:17.654Z",
      "version": 1
    },
    {
      "id": "test-title",
      "type": "text",
      "x": 744,
      "y": 389,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "Test capabilities",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:17.654Z",
      "updatedAt": "2026-08-06T17:26:17.654Z",
      "version": 1
    },
    {
      "id": "test-body",
      "type": "text",
      "x": 744,
      "y": 431,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "List and call MCP tools\nSend A2A messages",
      "fontSize": 21,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:17.654Z",
      "updatedAt": "2026-08-06T17:26:17.654Z",
      "version": 1
    },
    {
      "id": "run-title",
      "type": "text",
      "x": 744,
      "y": 604,
      "strokeColor": "#f8fafc",
      "roughness": 0,
      "text": "Run coding agents",
      "fontSize": 24,
      "fontFamily": 5,
      "createdAt": "2026-08-06T17:26:17.654Z",
