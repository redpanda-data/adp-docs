      "type": "text",
      "x": 744,
      "y": 646,
      "strokeColor": "#cbd5e1",
      "roughness": 0,
      "text": "Claude Code or Codex\nthrough AI Gateway",
      "fontSize": 21,
      "fontFamily": 5,
